{
  "name": "blogs",
  "type": "module",
  "version": "2.0.0",
  "packageManager": "pnpm@11.20.0",
  "description": "LRH's blogs",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11"
  },
  "scripts": {
    "docs:build": "vuepress-vite build src",
    "docs:clean-dev": "vuepress-vite dev src --clean-cache",
    "docs:dev": "vuepress-vite dev src",
    "docs:update-package": "pnpm dlx vp-update",
    "commit": "git-cz",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.3.0",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@commitlint/types": "^21.2.0",
    "@mdit/plugin-snippet": "^1.0.3",
    "@vue/repl": "^4.7.2",
    "@vuepress/bundler-vite": "2.0.0-rc.31",
    "@vuepress/plugin-slimsearch": "2.0.0-rc.131",
    "commitizen": "^4.3.2",
    "cz-git": "^1.13.1",
    "eslint": "^10.8.1",
    "eslint-config-vuepress": "^7.1.0",
    "eslint-plugin-format": "^2.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "markdown-it-livecodes": "^0.4.1",
    "sass-embedded": "^1.100.0",
    "typescript": "^6.0.3",
    "vue": "^3.5.41",
    "vuepress": "2.0.0-rc.31",
    "vuepress-theme-hope": "2.0.0-rc.107"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-git"
    }
  }
}
